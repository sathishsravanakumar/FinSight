# ── Venus Forex API Configuration ──────────────────────────
# Copy this file to .env and fill in the values

# JWT Secret (generate with: python -c "import secrets; print(secrets.token_hex(32))")
SECRET_KEY=your_secret_key_here_change_this_in_production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database
DATABASE_URL=sqlite:///./venus_forex.db

# ExchangeRate-API v6  →  https://app.exchangerate-api.com/dashboard
EXCHANGE_RATE_API_KEY=074a84758f5b9869803caa52

# Email OTP  (Gmail App Password)
# Steps to set up:
#   1. Enable 2-Step Verification on your Google account
#   2. Go to https://myaccount.google.com/apppasswords
#   3. Create an App Password for "Mail" → copy the 16-char password
#   4. Paste it below (no spaces)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=venusforex2005@gmail.com
SMTP_PASSWORD=your_gmail_app_password_here
EMAIL_FROM=Venus Forex <venusforex2005@gmail.com>

# Development mode: OTP is logged to console instead of emailed (set to true for local dev)
DEV_MODE=true
